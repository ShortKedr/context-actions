if(CPACK_GENERATOR STREQUAL "TGZ" AND NOT CPACK_SOURCE_INSTALLED_DIRECTORIES)
    set(CPACK_PACKAGING_INSTALL_PREFIX "/")
    set(CPACK_INSTALL_CMAKE_PROJECTS "@CMAKE_CURRENT_BINARY_DIR@;@PROJECT_NAME@;ALL;/usr")
    set(CPACK_INSTALLED_DIRECTORIES "@CMAKE_CURRENT_BINARY_DIR@/portable-installer;/")
endif()
